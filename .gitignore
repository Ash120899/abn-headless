# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent tooling
.claude/skills/

# Design concept sources. These are multi-MB single-file HTML mockups with
# every image inlined as base64 — reference material for building the real
# pages, not something the app imports. Keeping them out of history avoids
# bloating clones.
#
# Note: the concepts committed before this rule (the blog/case-study
# listings and hero-frames) stay tracked — a .gitignore entry does not
# untrack existing files, and removing them would need a deliberate
# `git rm --cached`.
design-concepts.zip
design-concepts/ABN_Digital_Marketing_V4_1_V3_Locked_Refinement.html
